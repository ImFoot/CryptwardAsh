{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cryptward Room Template Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "templates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "biome",
          "roles",
          "width",
          "height",
          "shape",
          "sockets",
          "markers",
          "tags"
        ]
      }
    }
  },
  "additionalProperties": false
}
